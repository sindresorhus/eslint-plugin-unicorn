exports[`prefer-type-error > invalid(1): if (!isFinite(foo)) {\n\tthrow new Error();\n} 1`] = `

  1 | if (!isFinite(foo)) {
  2 | 	throw new Error();
  3 | }

`;

exports[`prefer-type-error > invalid(1): if (!isFinite(foo)) {\n\tthrow new Error();\n} 2`] = `

Message:
  1 | if (!isFinite(foo)) {
> 2 | 	throw new Error();
    | 	          ^^^^^ \`new Error()\` is too unspecific for a type check. Use \`new TypeError()\` instead.
  3 | }

Output:
  1 | if (!isFinite(foo)) {
  2 | 	throw new TypeError();
  3 | }

`;

