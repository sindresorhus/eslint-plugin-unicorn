exports[`require-spread-parentheses > invalid(1): const object = {a, ...x && y}; 1`] = `

  1 | const object = {a, ...x && y};

`;

exports[`require-spread-parentheses > invalid(1): const object = {a, ...x && y}; 2`] = `

Message:
> 1 | const object = {a, ...x && y};
    |                       ^^^^^^ Wrap the spread argument in parentheses.

Output:
  1 | const object = {a, ...(x && y)};

`;

